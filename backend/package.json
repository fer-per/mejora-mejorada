{
  "name": "siarc-ara-backend",
  "version": "1.0.0",
  "description": "API REST del SIARC-ARA: autenticación y consulta documental del Archivo Regional de Arequipa",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node scripts/init-db.mjs",
    "db:schema": "node scripts/init-db.mjs --solo-esquema",
    "db:seed": "node scripts/init-db.mjs --solo-seed",
    "db:migrar-ara": "node scripts/migrar-db-ara.mjs",
    "storage:generar": "node scripts/generar-repositorio.mjs",
    "storage:subir": "node scripts/subir-repositorio.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:coverage": "vitest run --coverage",
    "db:test:reset": "node tests/helpers/preparar-bd.mjs",
    "db:test:verificar": "node ../pruebas/bd/verificar-bd.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}

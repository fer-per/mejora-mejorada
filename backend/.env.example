# Entorno de ejecución del API SIARC-ARA
# En producción use NODE_ENV=production (activa las validaciones de seguridad).
NODE_ENV=development
PORT=4000

# Conexión a PostgreSQL
# Para la base DB_ARA (datos reales migrados) use DB_NAME=DB_ARA y DB_SCHEMA=siarc.
# Para una instalación nueva con "npm run db:reset" use DB_NAME=siarc_db y DB_SCHEMA=public.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siarc_db
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Autenticación (JWT). Obligatorio: mínimo 16 caracteres.
JWT_SECRET=cambie-esta-clave-secreta-siarc-ara-2026
JWT_EXPIRA_EN=8h

# Administrador inicial (npm run admin:crear). Si ADMIN_PASSWORD se omite se genera una.
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@su-dominio.pe
ADMIN_PASSWORD=
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=SIARC

# Control de acceso por intentos fallidos (HU-17)
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15

# Repositorio digital (archivos TIFF/PDF-A y miniaturas)
RUTA_REPOSITORIO=../storage/repositorio

# Tamaño máximo por archivo en la ingesta documental (MB)
INGESTA_MAX_MB=60

# Almacenamiento del repositorio: local (disco) o r2 (Cloudflare R2)
ALMACENAMIENTO=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Prefijo opcional dentro del bucket (por ejemplo: repositorio)
R2_PREFIX=repositorio

# Compilación del frontend que el API sirve en producción
RUTA_FRONTEND=../frontend/dist

# Origen permitido del frontend (en producción use su dominio)
CORS_ORIGIN=http://localhost:5173
